# Build output
/build/

# Locally-cached AmiSSL SDK (scripts/fetch-amissl-sdk.sh) -- pinned
# outside $(BUILD) so it survives `make clean`, but never committed.
/.amissl-cache/

# Object files
*.o

# Python
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# Machine-specific Copperline config (absolute local paths)
/tests/copperline/*.local.toml

# Copperline on-target harness: run.sh-staged/generated per run, not
# source (binaries copied into boot/C/, plus the source/repo/restored/
# results host mounts it creates, wipes, and writes into each time).
/tests/copperline/boot/C/AmiSnap
/tests/copperline/boot/C/stage
/tests/copperline/boot/C/readback
/tests/copperline/boot/C/modify
/tests/copperline/source/
/tests/copperline/repo/
/tests/copperline/restored/
/tests/copperline/results/
/tests/copperline/ffs/

# run-perf.sh -- same story, its own boot volume + host mounts.
/tests/copperline/boot-perf/C/AmiSnap
/tests/copperline/boot-perf/C/bulkstage
/tests/copperline/boot-perf/C/timeit
/tests/copperline/source-perf/
/tests/copperline/repo-perf/
/tests/copperline/results-perf/

# run-uaem.sh -- entirely self-contained under one work directory
# (boot volume, sample repo, Source floppy ADF, results), not reusing
# the checked-in boot/ tree the way run.sh/run-ffs.sh do.
/tests/copperline/uaem-work/

# run-bigfile.sh -- same story, its own self-contained work directory.
/tests/copperline/bigfile-work/

# run-webdav.sh -- same story, its own self-contained work directory.
/tests/copperline/webdav-work/

# run-s3.sh -- same story, its own self-contained work directory
# (plus its second, env-var-credentials pass's own work directory).
/tests/copperline/s3-work/
/tests/copperline/s3-work-envcreds/

# Emulator-generated Workbench/UAE mount metadata when the repo root is
# mounted as an Amiga volume for on-target testing -- not source.
/Disk.info
/Disk.info.uaem

# Copyrighted reference material (Kickstart ROMs, Workbench installs, ...)
# that must never be committed or distributed -- see nondistribution/README.md.
/nondistribution/*
!/nondistribution/README.md
